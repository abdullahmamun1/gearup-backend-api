/// Emails waiting to be sent. Rows are written in the same transaction as the
/// change that triggers them, then sent right after the response and retried
/// by the daily cron job.
model EmailOutbox {
  id        String      @id @default(uuid())
  to        String
  template  String
  payload   Json
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  /// Stops the same email being queued twice (e.g. a pickup reminder).
  dedupeKey String?     @unique
  sendAfter DateTime    @default(now())
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAfter])
  @@map("email_outbox")
}
