model RentalOrder {
  id     String       @id @default(uuid())
  status RentalStatus @default(PLACED)

  /// Half-open range: units are held on every day in [startDate, endDate).
  startDate DateTime
  endDate   DateTime

  /// Rental cost only (pricePerDay × quantity × days). The deposit is separate.
  totalAmount Decimal @db.Decimal(10, 2)

  /// Refundable security deposit, charged together with the rental.
  depositAmount     Decimal       @default(0) @db.Decimal(10, 2)
  depositStatus     DepositStatus @default(NONE)
  damageClaimAmount Decimal?      @db.Decimal(10, 2)
  damageNote        String?

  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  /// Every order belongs to exactly one provider.
  providerId String
  provider   User   @relation("ProviderOrders", fields: [providerId], references: [id])

  /// PLACED orders stop holding stock (and are auto-cancelled) after this.
  respondBy    DateTime?
  /// CONFIRMED orders must be paid by this time.
  paymentDueAt DateTime?

  confirmedAt  DateTime?
  pickedUpAt   DateTime?
  returnedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason CancelReason?
  cancelNote   String?

  items    OrderItem[]
  payments Payment[]
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([status, startDate, endDate])
  @@map("rental_orders")
}
