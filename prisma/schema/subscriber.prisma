/// Newsletter subscribers (double opt-in). `token` is in every confirm and
/// unsubscribe link.
model Subscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  token          String    @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  /// Language of the newsletter and its emails.
  locale         Locale    @default(en)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}
