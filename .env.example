NODE_ENV = development

PORT = 5000

APP_URL = your_app_url

BCRYPT_SALT_ROUNDS = your_bcrypt_salt_rounds

JWT_ACCESS_SECRET = your_jwt_access_secret
JWT_REFRESH_SECRET = your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN = your_jwt_access_expires_in 
JWT_REFRESH_EXPIRES_IN = your_jwt_refresh_expires_in
DATABASE_URL=your_connection_string
STRIPE_SECRET_KEY = your_stripe_secret_key
STRIPE_WEBHOOK_SECRET = your_stripe_webhook_secret

GOOGLE_CLIENT_ID = your_google_client_id
GOOGLE_CLIENT_SECRET = your_google_client_secret

# Email (Nodemailer). Gmail: turn on 2-step verification, then create an
# App Password at https://myaccount.google.com/apppasswords. Leave SMTP_HOST
# empty in development to use a throwaway Ethereal inbox (preview links are
# printed in the server log).
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
SMTP_SECURE = true
SMTP_USER = your_gmail_address
SMTP_PASS = your_16_character_app_password
MAIL_FROM = GearUp <your_gmail_address>
ADMIN_EMAIL = where_contact_messages_go

# Protects GET /api/cron/daily. Set the same value in Vercel; it sends it
# automatically as a Bearer token when it runs the cron job.
CRON_SECRET = a_long_random_string
